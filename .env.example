# ==============================================================================
# AgriMart Environment Configuration Template
# Copy this file to .env and fill in your keys
# ==============================================================================

# 1. Weather Prediction & Forecast
VITE_OPENWEATHER_API_KEY=your_openweather_api_key
OPENWEATHER_API_KEY=your_openweather_api_key

# 2. Gemini AI Engine (Dialect parsing & dynamic crop advice)
VITE_GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY=your_gemini_api_key

# 3. Twilio SMS Dispatch & Notifications
VITE_TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_ACCOUNT_SID=your_twilio_sid
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_AUTH_TOKEN=your_twilio_auth_token
VITE_TWILIO_PHONE_NUMBER=your_twilio_phone
TWILIO_PHONE_NUMBER=your_twilio_phone

# 4. Supabase Cloud Database & Auth
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# 5. JWT Secret Key (256-bit cryptographically secure key for RBAC & Auth)
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 6. Google OAuth 2.0 Client Credentials
GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_CLIENT_ID=your_google_client_id
